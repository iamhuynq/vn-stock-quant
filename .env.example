# Copy to .env and fill in. Never commit .env.
# Paste the token with or without the "Bearer " prefix. Run commands with `uv run fireant ...`
# (do NOT use `uv run --env-file .env`, it prints unparseable lines, including the token).
FIREANT_TOKEN=<paste-token-here>
# Optional overrides
# DATA_DIR=data
# RATE_LIMIT_RPS=2.5
# MAX_RETRIES=5
# REQUEST_TIMEOUT_SECONDS=30
